{
  "name": "@footon/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SQLite and Drizzle infrastructure for Footon",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "files": ["src", "drizzle", "drizzle.config.ts", "README.md", "package.json"],
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:baseline": "bun src/baseline.ts",
    "db:migrate": "bun src/migrate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests drizzle.config.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.1"
  }
}
